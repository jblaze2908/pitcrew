# Pitcrew host config. On the server this lives at /etc/pitcrew/pitcrew.env (root, 0600);
# deploy/pull-update.sh feeds it to deploy/compose.yml. Model keys and site logins are not set here:
# add providers in Settings, and logins live in each crew member's own browser profile.

# Public hostname (behind your TLS proxy). Used for links in pushes and crew replies. Required.
PITCREW_HOST=pitcrew.example.com
# IANA zone for schedules, day totals and the crew's clock. Default UTC.
PITCREW_TZ=Europe/Berlin
# Domain crew member email addresses live on (see integrations/cloudflare-email). Defaults to PITCREW_HOST.
PITCREW_MAIL_DOMAIN=
# Optional: pre-fills Settings → Engram with your Engram server's address.
PITCREW_ENGRAM_URL=
# Crew computers running at once; each idles at ~300 MiB. Default 3.
PITCREW_MAX_COMPUTERS=3
# Optional ops alerts from the deploy script (ntfy topic URL and token).
NTFY_URL=
NTFY_TOKEN=
